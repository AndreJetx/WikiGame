# Session pooler (port 5432) — Drizzle Kit and Node API
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase client (do not expose the DB password to the frontend)
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Landing → wiki URL (local wiki Vite default port)
VITE_WIKI_URL=http://localhost:22172

# Cloudinary (unsigned upload from the wiki admin / editor)
# Create an unsigned upload preset in Cloudinary → Settings → Upload
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
